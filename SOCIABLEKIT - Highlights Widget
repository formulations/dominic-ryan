/* =========================================================
   DOMINIC RYAN — FORMULATIONS
   INSTAGRAM STORY HIGHLIGHTS

   CONSOLIDATED EDITION / OCTOBER 2026

   Design objectives:
   - Centered circular Highlights
   - Compact editorial presentation
   - Clean portrait Story viewer
   - Transparent expanded Story containers
   - No profile photograph in Story viewer
   - No Story header/title
   - Functional carousel navigation
   - Refined circular close button
   - Remove SociableKIT promotional branding
   - Responsive desktop and mobile layouts
   - Preserve animations regardless of reduced-motion settings
   ========================================================= */


/* =========================================================
   01 / DESIGN VARIABLES
   ========================================================= */

.sk-ww-instagram-story-highlights {
  --dr-highlight-size: 112px;
  --dr-highlight-gap: 14px;

  --dr-story-width: 390px;

  --dr-ink: #292621;
  --dr-accent: #9D8873;

  width: 100% !important;
  max-width: 100% !important;

  margin: 0 auto !important;
  padding: 0 !important;

  background: transparent !important;

  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}


/* =========================================================
   02 / REMOVE MAIN WIDGET HEADER

   Does not affect Story navigation.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-posts-header,

.sk-ww-instagram-story-highlights
.sk-header-follow-btn,

.sk-ww-instagram-story-highlights
.sk-button-follow-instagram {
  display: none !important;
}


/* =========================================================
   03 / WIDGET BODY
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-posts-body {
  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
}


/* =========================================================
   04 / HIGHLIGHTS STRIP
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-wrap {
  display: flex !important;

  justify-content: center !important;
  align-items: center !important;

  width: 100% !important;

  margin: 0 auto !important;
  padding: 0 !important;
}


/* =========================================================
   05 / HIGHLIGHTS VIEWPORT
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-viewport {
  width: 100% !important;
  max-width: 100% !important;

  margin: 0 auto !important;
  padding: 0 !important;

  overflow: hidden !important;
}


/* =========================================================
   06 / HIGHLIGHTS TRACK

   Scoped to the thumbnail strip.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-viewport
.sk-posts-stories {
  display: flex !important;

  justify-content: center !important;
  align-items: flex-start !important;

  flex-wrap: nowrap !important;

  gap: var(--dr-highlight-gap) !important;

  width: 100% !important;

  margin: 0 auto !important;
  padding: 0 !important;

  transform: none !important;
}


/* =========================================================
   07 / HIGHLIGHT ITEMS
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-viewport
.sk-posts-story-item {
  box-sizing: border-box !important;

  flex: 0 0 var(--dr-highlight-size) !important;

  width: var(--dr-highlight-size) !important;
  min-width: var(--dr-highlight-size) !important;
  max-width: var(--dr-highlight-size) !important;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;
  border: none !important;

  text-align: center !important;
}


/* =========================================================
   08 / CIRCULAR THUMBNAIL WRAPPERS
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-viewport
.sk-story-thumb-wrap {
  display: block !important;

  position: relative !important;

  box-sizing: border-box !important;

  width: var(--dr-highlight-size) !important;
  height: var(--dr-highlight-size) !important;

  min-width: var(--dr-highlight-size) !important;
  min-height: var(--dr-highlight-size) !important;

  max-width: var(--dr-highlight-size) !important;
  max-height: var(--dr-highlight-size) !important;

  aspect-ratio: 1 / 1 !important;

  margin: 0 auto !important;
  padding: 0 !important;

  overflow: hidden !important;

  border-radius: 50% !important;

  border: none !important;
  box-shadow: none !important;
}


/* =========================================================
   09 / CIRCULAR THUMBNAIL IMAGES

   Applies ONLY to Highlights thumbnails.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-viewport
.sk-story-thumb-wrap img {
  display: block !important;

  box-sizing: border-box !important;

  width: 100% !important;
  height: 100% !important;

  aspect-ratio: 1 / 1 !important;

  object-fit: cover !important;
  object-position: center center !important;

  border-radius: 50% !important;

  transform: none !important;
  filter: none !important;

  opacity: 1 !important;

  image-rendering: auto !important;

  transition: opacity 350ms ease !important;
}


/* =========================================================
   10 / HIGHLIGHT LABELS
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-viewport
.sk-story-highlight-title {
  display: block !important;

  width: 100% !important;

  margin: 9px 0 0 !important;
  padding: 0 !important;

  font-family: Georgia, "Times New Roman", serif !important;

  font-size: 12px !important;
  font-weight: 400 !important;

  line-height: 1.4 !important;

  color: var(--dr-ink) !important;

  text-align: center !important;
}


/* =========================================================
   11 / HIDE HIGHLIGHTS STRIP ARROWS

   Does not hide Story navigation.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-nav {
  display: none !important;
}


/* =========================================================
   12 / STORY VIEWER LAYOUT

   Center the expanded viewer.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout {
  display: flex !important;

  justify-content: center !important;
  align-items: flex-start !important;

  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  margin: 0 auto !important;
  padding: 0 !important;
}


/* =========================================================
   13 / STORY FRAME

   Prevent the oversized black rectangle.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-frame {
  position: relative !important;

  box-sizing: border-box !important;

  width: min(
    var(--dr-story-width),
    100%
  ) !important;

  max-width: var(--dr-story-width) !important;

  margin: 0 auto !important;
  padding: 0 !important;
}


/* =========================================================
   14 / STORY STAGE ROW

   Keep navigation aligned with the Story.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-stage-row {
  position: relative !important;

  display: flex !important;

  justify-content: center !important;
  align-items: center !important;

  width: 100% !important;
  min-width: 0 !important;

  margin: 0 auto !important;
}


/* =========================================================
   15 / STORY MAIN COLUMN
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-main-column {
  position: relative !important;

  box-sizing: border-box !important;

  flex: 1 1 auto !important;

  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
}


/* =========================================================
   16 / STORY STAGE WRAPPERS
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-stage-wrap,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-stage {
  position: relative !important;

  box-sizing: border-box !important;

  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
}


/* =========================================================
   17 / STORY CAROUSEL

   Preserve native carousel track movement.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-posts-carousel.sk-carousel-story {
  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  overflow: hidden !important;
}


/* =========================================================
   18 / STORY CAROUSEL TRACK

   Do not override transforms or navigation logic.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-carousel-track {
  display: flex !important;

  align-items: stretch !important;
}


/* =========================================================
   19 / STORY SLIDE DIMENSIONS

   Prevent 0px carousel items.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-carousel-story
.sk-carousel-track
.sk-carousel-item {
  box-sizing: border-box !important;

  flex: 0 0 100% !important;

  width: 100% !important;
  min-width: 100% !important;
  max-width: 100% !important;

  margin: 0 !important;
  padding: 0 !important;
}


/* =========================================================
   20 / STORY MEDIA CONTAINER

   Never apply circular thumbnail styling here.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-slide-media {
  position: relative !important;

  box-sizing: border-box !important;

  width: 100% !important;
  max-width: 100% !important;

  overflow: hidden !important;

  border-radius: 0 !important;
}


/* =========================================================
   21 / STORY IMAGES
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-slide-media img {
  display: block !important;

  width: 100% !important;
  height: auto !important;

  max-width: 100% !important;

  object-fit: contain !important;
  object-position: center center !important;

  aspect-ratio: auto !important;

  border-radius: 0 !important;

  transform: none !important;
  filter: none !important;
}


/* =========================================================
   22 / STORY VIDEOS
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-slide-media video {
  display: block !important;

  width: 100% !important;
  height: auto !important;

  max-width: 100% !important;

  object-fit: contain !important;
  object-position: center center !important;

  border-radius: 0 !important;
}


/* =========================================================
   23 / REMOVE STORY PROFILE HEADER

   Hide profile photographs, names and metadata
   within the expanded Story viewer.

   Does not affect thumbnail collection.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-header,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-profile,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-profile-image,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-profile-picture,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-avatar,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-user,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-user-info,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-author,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-author-info,

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-topbar {
  display: none !important;
}


/* =========================================================
   24 / STORY PROGRESS INDICATORS

   Preserve native progress functionality.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-progress {
  max-width: 100% !important;
}


/* =========================================================
   25 / STORY NAVIGATION

   Preserve previous / next functionality.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-story-viewer-layout
.sk-story-nav-btn {
  flex-shrink: 0 !important;

  cursor: pointer !important;
}


/* =========================================================
   26 / HOVER INTERACTION

   Animations remain active regardless of
   prefers-reduced-motion settings.
   ========================================================= */

@media (hover: hover) and (pointer: fine) {

  .sk-ww-instagram-story-highlights
  .sk-highlights-strip-viewport
  .sk-posts-story-item:hover
  .sk-story-thumb-wrap img {
    opacity: 0.85 !important;
  }

}


/* =========================================================
   27 / TABLET
   ========================================================= */

@media screen and (max-width: 1024px) {

  .sk-ww-instagram-story-highlights {
    --dr-highlight-size: 100px;
    --dr-highlight-gap: 12px;

    --dr-story-width: 360px;
  }

}


/* =========================================================
   28 / MOBILE
   ========================================================= */

@media screen and (max-width: 767px) {

  .sk-ww-instagram-story-highlights {
    --dr-highlight-size: 76px;
    --dr-highlight-gap: 12px;

    --dr-story-width: 100%;
  }

  .sk-ww-instagram-story-highlights
  .sk-highlights-strip-viewport {
    overflow-x: auto !important;
    overflow-y: hidden !important;

    -webkit-overflow-scrolling: touch;
  }

  .sk-ww-instagram-story-highlights
  .sk-highlights-strip-viewport
  .sk-posts-stories {
    justify-content: flex-start !important;

    width: max-content !important;
    min-width: 100% !important;
  }

  .sk-ww-instagram-story-highlights
  .sk-story-viewer-layout
  .sk-story-frame {
    width: 100% !important;
    max-width: 100% !important;
  }

}


/* =========================================================
   29 / EDITORIAL CIRCULAR STORY CLOSE BUTTON

   Desktop:
   - 28px visible circle
   - 12px inset

   Mobile:
   - 32px visible circle
   - 10px inset

   Preserves native close functionality.
   ========================================================= */

.sk-story-close,
.sk-story-close-btn,
.sk-story-viewer-layout .sk-story-close,
.sk-story-viewer-layout .sk-story-close-btn,
.sk-ww-instagram-story-highlights .sk-story-close,
.sk-ww-instagram-story-highlights .sk-story-close-btn {

  position: absolute !important;

  top: 12px !important;
  right: 12px !important;

  box-sizing: border-box !important;

  width: 28px !important;
  height: 28px !important;

  min-width: 28px !important;
  min-height: 28px !important;

  max-width: 28px !important;
  max-height: 28px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  padding: 0 !important;
  margin: 0 !important;

  border: 1px solid rgba(81, 70, 62, 0.22) !important;
  border-radius: 50% !important;

  background: rgba(251, 248, 242, 0.94) !important;

  color: #51463e !important;

  box-shadow:
    0 2px 8px rgba(70, 57, 47, 0.10) !important;

  cursor: pointer !important;

  z-index: 99999 !important;

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  transition:
    background 0.2s ease,
    box-shadow 0.2s ease !important;
}


/* Smaller close icon */

.sk-story-close svg,
.sk-story-close-btn svg,
.sk-story-viewer-layout .sk-story-close svg,
.sk-story-viewer-layout .sk-story-close-btn svg {

  width: 12px !important;
  height: 12px !important;

  stroke: #51463e !important;

  flex: none !important;
}


/* Desktop hover */

@media (hover: hover) and (pointer: fine) {

  .sk-story-close:hover,
  .sk-story-close-btn:hover {

    background: #fbf8f2 !important;

    box-shadow:
      0 4px 12px rgba(70, 57, 47, 0.14) !important;
  }

}


/* Mobile close button */

@media screen and (max-width: 767px) {

  .sk-story-close,
  .sk-story-close-btn,
  .sk-story-viewer-layout .sk-story-close,
  .sk-story-viewer-layout .sk-story-close-btn,
  .sk-ww-instagram-story-highlights .sk-story-close,
  .sk-ww-instagram-story-highlights .sk-story-close-btn {

    top: 10px !important;
    right: 10px !important;

    width: 32px !important;
    height: 32px !important;

    min-width: 32px !important;
    min-height: 32px !important;

    max-width: 32px !important;
    max-height: 32px !important;
  }

}


/* =========================================================
   30 / REMOVE SOCIABLEKIT PROMOTIONAL BRANDING

   Targets:
   - Branding beneath the Highlights strip
   - Promotional links beneath expanded Stories
   - Branding within Story viewer wrappers
   - Common SociableKIT branding containers

   Does not target Story navigation or media.
   ========================================================= */

.sk_branding,
.sk-branding,

.sk_branding .tutorial_link,
.sk-branding .tutorial_link,

.sk_branding a,
.sk-branding a,

.sk-ww-instagram-story-highlights .sk_branding,
.sk-ww-instagram-story-highlights .sk-branding,

.sk-ww-instagram-story-highlights
a[href*="sociablekit.com"],

.sk-story-viewer-layout
.sk_branding,

.sk-story-viewer-layout
.sk-branding,

.sk-story-viewer-layout
.tutorial_link,

.sk-story-viewer-layout
a[href*="sociablekit.com"],

.sk-highlight-story-shell
.sk_branding,

.sk-highlight-story-shell
.sk-branding,

.sk-highlight-story-shell
.tutorial_link,

.sk-highlight-story-shell
a[href*="sociablekit.com"],

a[href*="sociablekit.com/tutorials/"] {

  display: none !important;

  visibility: hidden !important;

  opacity: 0 !important;

  height: 0 !important;
  max-height: 0 !important;

  overflow: hidden !important;
}
/* =========================================================
   31 / EXPANDED STORY VIEWER
   UNIFIED EDITORIAL CONTAINER

   Confirmed DOM hierarchy:

   .sk-highlight-story-shell
     .sk-story-viewer-layout
       .sk-story-frame
         .sk-story-stage-row
           .sk-story-main-column
             .sk-story-stage-wrap
               .sk-story-stage

   Objectives:
   - Remove the cool gray-blue outer frame
   - Preserve the warm editorial background
   - Eliminate competing background declarations
   - Preserve Story dimensions and positioning
   - Preserve carousel navigation
   - Preserve progress indicators
   - Preserve the circular close button
   - Preserve existing animations
   - Apply consistently on desktop and mobile
   ========================================================= */


/* =========================================================
   31.1 / OUTERMOST STORY SHELL

   This is the outermost container confirmed
   in the inspected HTML.

   Remove its background so it cannot create
   a visible gray-blue border.
   ========================================================= */

.sk-highlight-story-shell {

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  outline: 0 !important;

  box-shadow: none !important;

}


/* =========================================================
   31.2 / STORY VIEWER BACKGROUND

   The viewer layout becomes the single
   source of the warm editorial background.

   All internal structural containers
   inherit this appearance through transparency.
   ========================================================= */

.sk-highlight-story-shell
.sk-story-viewer-layout {

  background: #e3dbd2 !important;

  border: 0 !important;
  outline: 0 !important;

  box-shadow: none !important;

}


/* =========================================================
   31.3 / TRANSPARENT INTERNAL STRUCTURE

   Remove additional backgrounds and framing
   from structural wrappers only.

   Do not modify:
   - Dimensions
   - Positioning
   - Flex properties
   - Transforms
   - Overflow
   - Carousel behavior
   ========================================================= */

.sk-highlight-story-shell
.sk-story-frame,

.sk-highlight-story-shell
.sk-story-stage-row,

.sk-highlight-story-shell
.sk-story-main-column,

.sk-highlight-story-shell
.sk-story-stage-wrap,

.sk-highlight-story-shell
.sk-story-stage {

  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;

  border: 0 !important;
  outline: 0 !important;

  box-shadow: none !important;

}


/* =========================================================
   31.4 / REMOVE DECORATIVE FRAME EFFECTS

   Neutralize decorative backgrounds and
   borders on structural pseudo-elements.

   Does not target Story progress indicators.
   ========================================================= */

.sk-highlight-story-shell::before,
.sk-highlight-story-shell::after,

.sk-highlight-story-shell
.sk-story-viewer-layout::before,

.sk-highlight-story-shell
.sk-story-viewer-layout::after,

.sk-highlight-story-shell
.sk-story-stage-wrap::before,

.sk-highlight-story-shell
.sk-story-stage-wrap::after {

  background: transparent !important;
  background-image: none !important;

  border-color: transparent !important;

  outline: none !important;

  box-shadow: none !important;

}


/* =========================================================
   32 / DESKTOP AND MOBILE CONSISTENCY

   The same container treatment applies
   across all viewport sizes.

   Existing responsive Story dimensions
   remain controlled by Sections 27–28.
   ========================================================= */

@media screen and (max-width: 767px) {

  .sk-highlight-story-shell {

    background: transparent !important;

    border: 0 !important;
    outline: 0 !important;

    box-shadow: none !important;

  }

  .sk-highlight-story-shell
  .sk-story-viewer-layout {

    background: #e3dbd2 !important;

    border: 0 !important;
    outline: 0 !important;

    box-shadow: none !important;

  }

}


/* =========================================================
   33 / PRESERVE EDITORIAL ANIMATIONS

   Do not disable animations when the device
   requests reduced motion.

   Preserve existing thumbnail and close-button
   transitions across desktop and mobile.
   ========================================================= */

.sk-ww-instagram-story-highlights
.sk-highlights-strip-viewport
.sk-story-thumb-wrap img {

  transition: opacity 350ms ease !important;

}


.sk-story-close,
.sk-story-close-btn,
.sk-story-viewer-layout .sk-story-close,
.sk-story-viewer-layout .sk-story-close-btn {

  transition:
    background 200ms ease,
    box-shadow 200ms ease !important;

}
